# ErnsAuth — Apache vhost, HTTP only (auth.erns.eu)
#
# HTTP only for now. Run `certbot --apache -d auth.erns.eu` once this is
# live to add the HTTPS vhost (and, if you accept certbot's prompt, the
# redirect to it). Don't hand-add an HTTP->HTTPS redirect here yourself --
# see the note about web/.htaccess below, which already has one from the
# app's own security hardening and needs attention before this goes live.
#
# Required modules: a2enmod headers rewrite authn_file authz_core alias
# Enable with:       a2ensite auth.erns.eu && systemctl reload apache2
#
# ServerTokens is a server-config-only directive (not valid inside a
# VirtualHost) -- set `ServerTokens Prod` once in
# /etc/apache2/conf-available/security.conf if it isn't already.

<VirtualHost *:80>
    ServerName auth.erns.eu

    # >>> EDIT: set this to ernsauth's actual path on this server <<<
    DocumentRoot /path/to/ernsauth/web

    <Directory /path/to/ernsauth/web>
        AllowOverride All
        Require all granted
        Options -Indexes -MultiViews -ExecCGI

        <LimitExcept GET POST HEAD>
            Require all denied
        </LimitExcept>
    </Directory>

    # src/, config/, client/, lib/ all sit outside DocumentRoot (web/) and
    # are never served regardless of filename -- nothing to deny explicitly.

    # Defense in depth: web/.htaccess already denies dotfiles and
    # .log/.sql/.sqlite/.json/.md/.php~ within web/; this backs that up at
    # the server level in case AllowOverride is ever turned down later.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(log|sql|sqlite|json|md|php~)$">
        Require all denied
    </FilesMatch>

    TraceEnable Off
    ServerSignature Off

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # No HSTS here -- the header is a no-op over plain HTTP by spec. Add it
    # only after certbot has switched this vhost to HTTPS.

    ErrorLog ${APACHE_LOG_DIR}/auth.erns.eu-error.log
    CustomLog ${APACHE_LOG_DIR}/auth.erns.eu-access.log combined
</VirtualHost>

# ── Before going live over plain HTTP ───────────────────────────────────────
# web/.htaccess unconditionally redirects to HTTPS (RewriteCond %{HTTPS}
# off / X-Forwarded-Proto !https -> 301 to https://%{HTTP_HOST}...). That's
# correct once a certificate exists, but with no HTTPS vhost yet, it would
# redirect every request to an address nothing is listening on -- the site
# would be unreachable, not just insecure. Comment out that RewriteRule (or
# the whole RewriteEngine block) in web/.htaccess until certbot has created
# the :443 vhost, then restore it -- certbot's own redirect prompt makes a
# second one redundant but harmless once a cert is actually in place.
